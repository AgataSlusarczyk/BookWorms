{
  // Run with Cmd+Shift+P → "Tasks: Run Task", or Cmd+Shift+B for "Start everything".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database: start",
      "detail": "Postgres in Docker on localhost:5434 (bookworms / secret)",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "options": { "cwd": "${workspaceFolder}/server" },
      "problemMatcher": []
    },
    {
      "label": "Database: stop",
      "type": "shell",
      "command": "docker compose stop",
      "options": { "cwd": "${workspaceFolder}/server" },
      "problemMatcher": []
    },
    {
      "label": "Database: reset (deletes all data)",
      "detail": "Starts from an empty database – Flyway runs all migrations again",
      "type": "shell",
      "command": "docker compose down -v && docker compose up -d --wait",
      "options": { "cwd": "${workspaceFolder}/server" },
      "problemMatcher": []
    },
    {
      "label": "Server: run",
      "detail": "Database + Spring Boot on http://localhost:8080",
      "type": "shell",
      "command": "./gradlew bootRun",
      "options": { "cwd": "${workspaceFolder}/server" },
      "dependsOn": "Database: start",
      "isBackground": true,
      // Tells VS Code the server is ready once Spring prints "Started ServerApplication".
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "beginsPattern": "Starting ServerApplication",
          "endsPattern": "Started ServerApplication"
        }
      }
    },
    {
      "label": "Android: run on emulator",
      "detail": "Installs the app on the running emulator or phone and opens it",
      "type": "shell",
      // adb from PATH, or from the default Android Studio SDK folder on a Mac.
      "command": "ADB=$(command -v adb || echo \"$HOME/Library/Android/sdk/platform-tools/adb\") && ./gradlew installDebug && \"$ADB\" shell am start -n com.bookworms.app/.MainActivity",
      "options": { "cwd": "${workspaceFolder}/android" },
      "problemMatcher": []
    },
    {
      "label": "Start everything",
      "detail": "Database, server and the app on the emulator",
      "dependsOn": ["Server: run", "Android: run on emulator"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
