<?xml version="1.0" encoding="utf-8"?>
<!-- What Android may copy to Google's backup or to a new phone (Android 12+). -->
<data-extraction-rules>
    <!-- The login token (see Session) stays on this phone only. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
